<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Community Page Flow Launcher</masterLabel>
    <description>Community pages Flow Launcher with input parameter matches to URL parameters. Pass in Flow name as input</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="flowName" type="String" label="Flow API Name" default="SF_Community_Create_Web_to_Case" />
            <property name="requestType" type="String" label="Request Type" default="ending-my-tenancy" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>